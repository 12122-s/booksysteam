# ============================================================
# 图书管理系统（Java 版）· 环境变量模板
#
# 用法：复制这个文件为 .env，按需要修改。.env 已被 .gitignore 忽略，
#       不会提交到 git（密码不要进版本库）。
#
# 注意：MySQL 的账号密码只在「数据目录第一次初始化」时生效。
#       如果你的 ./dbdata 已经初始化过，改这里的密码不会生效 ——
#       要么进容器手动改账号，要么删掉 ./dbdata 重新初始化（会清空数据）。
# ============================================================

# ---------------- Docker Compose 部署用 ----------------

# MySQL 的 root 密码（容器内部用，不对外暴露）
MYSQL_ROOT_PASSWORD=root-dev-pwd

# 应用连库用的专用账号密码（对应 compose 里的 MYSQL_USER=library_java）
LIB_DB_PASSWORD=library-java-dev-pwd


# ---------------- 不用 Docker、直接 java -jar 运行用 ----------------
# 取消注释并按实际情况修改；Docker 部署时不用管这几行。
#
# LIB_DB_HOST=127.0.0.1
# LIB_DB_PORT=3306
# LIB_DB_USER=root
# LIB_DB_PASSWORD=123456
# LIB_DB_NAME=library_system
# SERVER_PORT=8081


# ---------------- JWT ----------------
# 签名密钥，至少 32 个字符。生产环境务必换成随机长字符串。
# LIB_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# token 有效期（分钟），默认 120
# LIB_JWT_TTL_MINUTES=120

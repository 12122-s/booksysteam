# ============================================================
# 图书管理系统（Java 版）· 环境变量模板
# 复制为 .env 或在启动前 export / set 这些变量即可生效
# ============================================================

# 数据库连接（默认连本机 MySQL，root/123456，库名 library_system）
# LIB_DB_HOST=127.0.0.1
# LIB_DB_PORT=3306
# LIB_DB_USER=root
# LIB_DB_PASSWORD=123456
# LIB_DB_NAME=library_system

# 会话签名密钥：生产环境务必换成一个随机长字符串
# （Java 版会话由容器管理，此变量保留仅为与 Python 版部署习惯一致）
# LIB_SECRET_KEY=change-me-to-a-long-random-string
